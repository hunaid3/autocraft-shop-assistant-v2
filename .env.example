# Copy to .env for local runs. Real values live in AWS Secrets Manager / Supabase vault — never commit them.

# Core engine connects as the restricted app_engine role (RLS applies), never as postgres/service_role.
DATABASE_URL=postgres://app_engine:app_engine_local@localhost:54329/shop

# Meta WhatsApp Cloud API
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# check the current version at developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v23.0
# the bot's own number, digits only; the engine never answers itself
BOT_PHONE=917013539950

WORKER_CONCURRENCY=8
LOG_LEVEL=info

# AI reader. Leave the key empty to run on the rule-based reader only.
# The real key lives in Supabase Vault (openai_api_key) / AWS Secrets Manager — never here or in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry (org autocraft-solutions, EU region, project shop-assistant-v2). Not secret, but set per environment.
SENTRY_DSN=
APP_ENV=development
# git sha, set by the deploy
RELEASE=

PORT=8080
TZ=Asia/Kolkata
