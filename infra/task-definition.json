{
  "family": "shop-assistant",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::886069266990:role/autocraft-ecs-execution",
  "taskRoleArn": "arn:aws:iam::886069266990:role/autocraft-shop-assistant-task",
  "containerDefinitions": [
    {
      "name": "engine",
      "image": "886069266990.dkr.ecr.ap-south-1.amazonaws.com/autocraft/shop-assistant:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp", "name": "http" }],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "PORT", "value": "8080" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "WORKER_CONCURRENCY", "value": "4" },
        { "name": "BOT_PHONE", "value": "917013539950" },
        { "name": "META_APP_ID", "value": "1541875984627224" },
        { "name": "META_WABA_ID", "value": "1482068713779854" },
        { "name": "DB_HOSTS", "value": "aws-0-ap-south-1.pooler.supabase.com,aws-1-ap-south-1.pooler.supabase.com" },
        { "name": "CHROME_PATH", "value": "/usr/bin/chromium" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-south-1:886069266990:secret:autocraft/v2/db-engine-password-MqtvUx" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": { "awslogs-group": "/autocraft/shop-assistant", "awslogs-region": "ap-south-1", "awslogs-stream-prefix": "engine" }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 90
      },
      "stopTimeout": 60,
      "linuxParameters": { "initProcessEnabled": true }
    }
  ]
}
