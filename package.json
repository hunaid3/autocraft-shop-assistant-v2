{
  "name": "autocraft-shop-assistant-v2",
  "version": "0.1.0",
  "description": "AutoCraft Shop Assistant V2 — multi-tenant WhatsApp inventory & billing engine",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:db": "vitest run test/db",
    "db:local": "bash scripts/local-db.sh",
    "check": "npm run typecheck && npm run lint && npm test",
    "simulate": "tsx scripts/simulate.ts",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
